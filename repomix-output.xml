@pytest.mark.parametrize('body', [
    b'{"draft": NaN}', b'{"draft": Infinity}', b'{"draft": 1e999}',
    b'{"draft":"invalid\\ud800"}', b'{"draft":"bad\xff"}',
    b'{"draft": "incomplete', b'[]', b'null',
