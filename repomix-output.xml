<file path="frontend/src/features/auth/AuthPage.css">
.sana-auth {
  --sana-ink: var(--text);
  --sana-muted: var(--muted);
  --sana-border: var(--border);
  --sana-paper: var(--bg);
  --sana-green: var(--accent);
  --sana-lime: var(--action);
  display: grid;
  grid-template-columns: minmax(420px, 46%) minmax(0, 1fr);
  width: 100%;
  min-height: 100svh;
  color: var(--text);
  background: var(--bg);
  font: 14px/1.6 var(--font-body);
  text-align: left;
  letter-spacing: 0;
  color-scheme: light;
}
