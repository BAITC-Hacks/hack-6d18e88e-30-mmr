@contextmanager
def mock_remote(**kwargs):
    remote = Mock(**kwargs)

    @contextmanager
    def stream(*args, **options):
        reply = remote(*args, **options)
        try:
            yield reply
        finally:
            reply.close()

    with patch("backend.services.supabase_gateway.httpx.stream", side_effect=stream):
        yield remote


