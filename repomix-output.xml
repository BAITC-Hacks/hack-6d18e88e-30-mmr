/* Shared presentation layer. Business state and contracts remain in their feature modules. */
body { background: var(--bg); }
h1 { font-family: var(--font-display); font-size: clamp(27px, 2.6vw, 40px); font-weight: 600; letter-spacing: -.055em; line-height: 1.23; }
h2, h3 { letter-spacing: -.035em; }
::selection { color: var(--on-action); background: var(--action); }
:is(button,a,input,textarea,select,summary):focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
