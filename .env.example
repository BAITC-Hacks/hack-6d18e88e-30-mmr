OPENAI_API_KEY=
NVIDIA_API_KEY=
AI_PROVIDER=openai
AI_MODEL=
BACKEND_PORT=8000

# Shared API deployment guards (production requires a strong token and explicit HTTPS origins).
APP_ENV=development
API_ACCESS_TOKEN=
# API_ALLOWED_HOSTS=localhost,127.0.0.1
# API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Accounts: paths are relative to the repository root.
DATABASE_PATH=backend/data/app.sqlite3
AUTH_PAGE_URL=http://localhost:8000/account
# Accounts inherit API_ALLOWED_ORIGINS unless this optional extra list is set.
# CORS_ORIGINS=http://localhost:5173,http://localhost:8000
SESSION_HOURS=24
# Set true for HTTPS deployment. Use one hostname consistently (localhost OR 127.0.0.1).
COOKIE_SECURE=false

# file = local .eml previews; smtp = real delivery by the background worker.
MAIL_BACKEND=file
MAIL_DIRECTORY=backend/data/mail
MAIL_WORKER_ENABLED=true
MAIL_FROM=AI Sana <noreply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
