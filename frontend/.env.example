# Save a copy as frontend/.env.local. Never place a Supabase secret/service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Empty = same-origin /api (Vite proxies it to http://127.0.0.1:8000).
VITE_API_BASE_URL=
# In npm run dev, empty Supabase values enable local FastAPI auth for development.
# Production builds require both Supabase values; configured provider errors never fall back.
# No provider API key belongs in the frontend.
# Set local for a deterministic demo without backend or external AI calls.
VITE_AI_MODE=auto
