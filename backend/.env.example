# Leave keys empty to use the deterministic local analyzer.
# Copy to backend/.env; never put provider keys in VITE_* variables.
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Optional model override for the configured provider.
AI_MODEL=

# Development accepts loopback clients only; bind uvicorn to 127.0.0.1 and use
# --no-proxy-headers so untrusted forwarding headers cannot change the peer IP.
APP_ENV=development
# Optional in development; REQUIRED in production (32-256 random ASCII chars).
# Server/gateway credential only. NEVER place this token in VITE_* or browser code.
API_ACCESS_TOKEN=
# Exact hosts/origins only. Production must explicitly set these; HTTPS origins
# are required. Examples: api.example.com / https://app.example.com
API_ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
# Bounded per-process budgets; use one worker for the demo. Multiple processes
# or replicas need a shared gateway budget in addition to these local limits.
API_RATE_LIMIT_PER_CLIENT=60
API_RATE_LIMIT_GLOBAL=300
API_RATE_LIMIT_WINDOW_SECONDS=60
